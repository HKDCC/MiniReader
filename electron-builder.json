{
  "appId": "com.quaxstudio.minireader",
  "productName": "Mini Reader",
  "asar": true,
  "extraResources": [
    {
      "from": "public/app-icon.ico",
      "to": "app-icon.ico"
    }
  ],
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist_electron/**/*",
    "package.json",
    "!node_modules/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/app-icon.ico",
    "artifactName": "Mini Reader-${version}-x64.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "fileAssociations": [
    { "ext": "txt", "name": "Text Document", "role": "Viewer" },
    { "ext": "epub", "name": "EPUB eBook", "role": "Viewer" },
    { "ext": "pdf", "name": "PDF Document", "role": "Viewer" }
  ]
}
